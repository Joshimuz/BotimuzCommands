	<command>
		<name>Schedule</name>
		<maxWords>15</maxWords>
		<requiredwords>
			<group>
				<word wholeword="true">bot</word>
				<word>botimuz</word>
				<word>what</word>
				<word>where</word>
				<word>give</word>
				<word>!schedule</word>
			</group>
			<group>
				<word>schedule</word>
				<word>link</word>
				<word>pastebin</word>
				<word>horaro</word>
				<word>!schedule</word>
			</group>
		</requiredwords>
		<unwantedwords>
			<group>
				<word>watch</word>
				<word>saw</word>
				<word>version</word>
				<word>wants</word>
				<word>played</word>
				<word>playing</word>
				<word wholeword="true">esa</word>
			</group>
		</unwantedwords>
		<responses>
			<response>joshDoneQuick Josh Done Quick is a six day solo marathon run by Josh! Schedule and details: https://horaro.net/jdq/rggm joshDoneQuick</response>
		</responses>
	</command>

